<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Prioritize React index.html while preserving default.php on server
  DirectoryIndex index.html index.php default.php

  # 2. Security: Deny all direct web access to backend source, .env, .git, and composer files
  RewriteRule ^backend(/|$) - [F,L,NC]
  RewriteRule (^|/)\.(env|git) - [F,L,NC]
  RewriteRule (^|/)composer\.(json|lock) - [F,L,NC]
  RewriteRule ^storage/logs/ - [F,L,NC]

  # 3. Handle Authorization Header for API tokens (Sanctum/Bearer)
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # 4. Route all /api requests to the Laravel API bridge
  RewriteCond %{REQUEST_URI} ^/api [NC]
  RewriteRule ^api(/.*)?$ api/index.php [L,QSA]

  # 5. If file or folder exists physically, serve directly (assets, favicon, logo, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 6. Single Page Application (SPA) fallback - send all other requests to index.html
  RewriteRule ^ index.html [L]
</IfModule>

# Enable Gzip compression for faster loading
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml
</IfModule>

# Browser Caching for static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/gif "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>
