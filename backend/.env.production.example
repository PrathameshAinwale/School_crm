# ==============================================================================
# LARAVEL BACKEND PRODUCTION ENVIRONMENT TEMPLATE (HOSTINGER)
# Create or edit this file on Hostinger: /home/uXXXXX/backend/.env (or in File Manager)
# NEVER commit real passwords or app secrets to GitHub.
# ==============================================================================

APP_NAME="Arch Campus"
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_TIMEZONE=Asia/Kolkata
APP_URL=https://archcampus.archenterprises.co.in
FRONTEND_URL=https://archcampus.archenterprises.co.in

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ------------------------------------------------------------------------------
# HOSTINGER PRODUCTION MYSQL DATABASE
# In Hostinger hPanel -> Databases -> MySQL Databases:
# Database Host is 127.0.0.1 or localhost, port is 3306
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_hostinger_db_name
DB_USERNAME=your_hostinger_db_user
DB_PASSWORD=your_hostinger_db_password

# ------------------------------------------------------------------------------
# SESSION, CACHE & QUEUE DRIVERS
# ------------------------------------------------------------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

SANCTUM_STATEFUL_DOMAINS=archcampus.archenterprises.co.in

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=file
CACHE_STORE=file

# ------------------------------------------------------------------------------
# MAIL CONFIGURATION (Hostinger SMTP)
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=notifications@archenterprises.co.in
MAIL_PASSWORD=your_email_password
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="notifications@archenterprises.co.in"
MAIL_FROM_NAME="${APP_NAME}"
