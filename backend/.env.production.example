# ==============================================================================
# LARAVEL BACKEND PRODUCTION ENVIRONMENT CONFIGURATION
# Copy this file to .env in your Hostinger backend directory (/backend/.env)
# NEVER commit the real .env file with actual credentials to source control.
# ==============================================================================

APP_NAME="Arch Campus"
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_TIMEZONE=Asia/Kolkata
APP_URL=https://archcampus.archenterprises.co.in
FRONTEND_URL=https://archcampus.archenterprises.co.in

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ------------------------------------------------------------------------------
# HOSTINGER PRODUCTION MYSQL DATABASE
# Database Host on Hostinger is typically 127.0.0.1 or localhost
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u773098752_sms
DB_USERNAME=u773098752_sms
DB_PASSWORD=6*9/PD~WTYZe

# ------------------------------------------------------------------------------
# SESSION, CACHE & QUEUE DRIVERS
# On shared hosting without Redis/Memcached daemon, 'file' is recommended
# ------------------------------------------------------------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

SANCTUM_STATEFUL_DOMAINS=archcampus.archenterprises.co.in

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=file
CACHE_STORE=file

# ------------------------------------------------------------------------------
# MAIL CONFIGURATION (Production Hostinger SMTP)
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=notifications@archenterprises.co.in
MAIL_PASSWORD=your_mail_password
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="notifications@archenterprises.co.in"
MAIL_FROM_NAME="${APP_NAME}"
